/* 设置页（pages/settings） */

.field {
  margin-top: 24rpx;
}

.field__label {
  font-size: 25rpx;
  color: var(--text-2);
  display: block;
  margin-bottom: 12rpx;
}

.field__input {
  height: 84rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--line);
  border-radius: var(--r-sm);
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--text);
}

.field__placeholder {
  color: var(--text-3);
  font-size: 27rpx;
}

.settings__buttons {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 28rpx;
}

.settings__result {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--r-sm);
  background: var(--surface-2);
  font-size: 25rpx;
  color: var(--text-2);
  line-height: 1.5;
  word-break: break-all;
}

.settings__note {
  margin-top: 20rpx;
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.6;
}

/* 访问令牌输入框（P2-5） */
.settings__input {
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border: 1px solid var(--border-1);
  border-radius: var(--r-sm);
  background: var(--surface-2);
  font-size: 26rpx;
  color: var(--text-1);
  line-height: 1.5;
}

/* 开关行 */
.setting-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.setting-row--column {
  flex-direction: column;
  align-items: stretch;
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-row__title {
  font-size: 28rpx;
  color: var(--text);
}

.setting-row__desc {
  font-size: 23rpx;
  color: var(--text-3);
  margin-top: 4rpx;
  line-height: 1.5;
}

.setting-row__value {
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 500;
}

.setting-row--link {
  margin-top: 8rpx;
  border-bottom: none;
}

.setting-row__arrow {
  font-size: 40rpx;
  color: var(--text-3);
  margin-left: 16rpx;
}

/* 学习画像 */
.stats {
  display: flex;
  flex-direction: row;
  margin-top: 24rpx;
}

.stats__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats__num {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--brand);
  line-height: 1.2;
}

.stats__label {
  font-size: 23rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.mistake {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.mistake__bad {
  color: var(--danger);
  text-decoration: line-through;
  text-decoration-color: rgba(229, 72, 77, 0.4);
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mistake__arrow {
  color: var(--text-3);
  margin: 0 14rpx;
}

.mistake__good {
  color: var(--brand-strong);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mistake__count {
  color: var(--text-3);
  font-size: 23rpx;
  margin-left: 12rpx;
}

/* 音色试听行 */
.settings__preview {
  margin-top: 20rpx;
  align-items: center;
}

.settings__preview-hint {
  margin-top: 0;
  flex: 1;
}

/* 服务端信息 */
.info-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 14rpx 0;
}

.info-row__label {
  font-size: 26rpx;
  color: var(--text-3);
}

.info-row__value {
  font-size: 26rpx;
  color: var(--text);
}
