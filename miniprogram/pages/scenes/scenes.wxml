<!-- 场景选择：最近使用 + 分类列表 -->
<view class="page">
  <view class="continue-bar">
    <view class="col grow">
      <text class="continue-bar__title">延续上次话题</text>
      <text class="continue-bar__desc">开启后，AI 会接着上次的聊天继续开场</text>
    </view>
    <switch
      checked="{{continueMode}}"
      color="#0F766E"
      bindchange="onToggleContinue"
    />
  </view>

  <block wx:if="{{recent.length > 0}}">
    <view class="section-title">最近用过</view>
    <view class="recent">
      <view
        wx:for="{{recent}}"
        wx:key="id"
        class="recent__item"
        data-id="{{item.id}}"
        bind:tap="onPickScene"
      >
        <text class="recent__name">{{item.name}}</text>
        <text class="recent__en">{{item.name_en}}</text>
      </view>
    </view>
  </block>

  <block wx:for="{{groups}}" wx:key="category">
    <view class="section-title">{{item.label}}</view>
    <view
      wx:for="{{item.scenes}}"
      wx:for-item="scene"
      wx:key="id"
      class="scene-card"
      data-id="{{scene.id}}"
      bind:tap="onPickScene"
    >
      <view class="row row--between">
        <text class="scene-card__name">{{scene.name}}</text>
        <text class="scene-card__en">{{scene.name_en}}</text>
      </view>
      <view class="scene-card__desc">{{scene.description}}</view>
      <view class="scene-card__goal">目标：{{scene.goal}}</view>
    </view>
  </block>

  <view wx:if="{{!loading && groups.length === 0}}" class="empty">
    <view class="empty__icon">🗂️</view>
    <view class="empty__title">还没有可用场景</view>
    <view class="empty__desc">请确认后端服务已启动并配置了场景数据</view>
  </view>
</view>
