# ============================================================
# SpeakMate 后端环境变量模板
# 使用：复制本文件为 .env 并按需修改；未配置的项使用默认值。
# 默认 LLM_PROVIDER=mock（零依赖联调模式，不调用真实 LLM，
# 返回内置模拟对话数据，供前端开发与冒烟测试使用）。
# ============================================================

# ---- LLM 接入 ----
# LLM 提供方：mock | deepseek | qwen | openai | lmstudio | ollama
LLM_PROVIDER=mock

# LLM 服务地址（OpenAI 兼容 /v1 端点）。
# 留空时使用 provider 预设：
#   deepseek = https://api.deepseek.com/v1
#   qwen     = https://dashscope.aliyuncs.com/compatible-mode/v1
#   openai   = https://api.openai.com/v1
#   lmstudio = http://localhost:1234/v1
# 显式配置可覆盖预设（例如自建网关 / 反向代理地址）。
#LLM_BASE_URL=

# LLM API 密钥（仅存后端 .env，绝不透传前端或写入日志）。
# deepseek / qwen / openai 必填；lmstudio 本地模式填任意占位即可。
#LLM_API_KEY=

# 模型名称（以各 provider 实际可用模型为准；
# lmstudio 以本地已加载模型显示的名称为准，示例为 qwen3.6-35b-a3b）。
# 留空时使用 provider 预设（deepseek-chat / qwen-plus / gpt-4o-mini 等）。
#LLM_MODEL=

# qwen3 / lmstudio 本地模型：是否允许输出 <think> 思考块。
# 默认 false（请求体附加 chat_template_kwargs.enable_thinking=false 关闭，
# 解析器亦会自动剥离已出现的 think 块，双保险）；设 true 可观察原始思考输出。
#LLM_ENABLE_THINKING=false

# ---- 服务 ----
# 后端监听端口（前端 Vite 开发代理将 /api 转发至此端口）
PORT=3001

# ---- HTTPS（可选；手机使用麦克风必须，详见 ../DEPLOYMENT.md 方案A）----
# 浏览器 Web Speech API 的麦克风授权要求「安全上下文」：
# 手机访问 http://<局域网IP> 时无法授权麦克风，必须走 https://。
# 用 mkcert 为局域网 IP 签发自签证书后，配置以下两项，
# 后端会在 HTTPS_PORT（默认 3443）额外启动一个 HTTPS 服务（HTTP 不受影响）。
# 证书生成命令序列见 DEPLOYMENT.md「方案A · A3～A4」。
#HTTPS_KEY_FILE=./certs/speakmate-key.pem
#HTTPS_CERT_FILE=./certs/speakmate-cert.pem
#HTTPS_PORT=3443

# 产品显示名（设置页 / 顶栏展示，可自定义）
APP_NAME=SpeakMate

# SQLite 数据文件目录（相对 backend 运行目录；启动时自动创建，自动建库）
DATA_DIR=./data

# ---- 访问控制（公网/半公网部署必读）----
# 访问令牌：留空 = 不鉴权（本机/局域网默认形态）。
# 配置后 /api/* 全部要求 `Authorization: Bearer <token>`（**不接受 URL 参数**，
# 避免令牌进入访问日志 / 浏览器历史 / Referer）。
# 前端在「设置 → 访问令牌」录入同样的值，保存在本机 localStorage。
# 生成示例：openssl rand -hex 32
#ACCESS_TOKEN=

# CORS 允许的前端来源，逗号分隔的**精确** origin（不含路径、不含通配符）。
# 留空 = 同源部署，不返回任何 CORS 头（最严格，推荐配合前端 dev proxy 或同域反代）。
# 例：CORS_ORIGIN=https://speakmate.example.com,http://192.168.1.20:5173
# 注意：'*' 会被拒绝并回落到同源策略——那等价于对全网开放读写。
#CORS_ORIGIN=

# 反向代理后面运行时，是否信任 X-Forwarded-For（用于速率限制按真实客户端 IP 计数）。
# 只有在 Nginx / Caddy 等反代之后才设为 true；直接暴露时设为 true 会导致
# 客户端伪造 X-Forwarded-For 绕过速率限制。
#TRUST_PROXY=false

# 速率限制（每分钟每 IP）：LLM 类 / 写操作 / 读操作。
# 默认 30 / 120 / 300；必须是正整数，非法值自动回退默认。
#RATE_LIMIT_LLM_PER_MIN=30
#RATE_LIMIT_WRITE_PER_MIN=120
#RATE_LIMIT_READ_PER_MIN=300

# 测试环境（NODE_ENV=test）下默认关闭限流，避免集成测试因共享计数被 429 阻断；
# 需要在测试中验证限流行为时设为 true。
#ENABLE_RATE_LIMIT=false

# ============================================================
# 常用配置示例（取消注释并按需修改）
# ============================================================

# --- 示例 1：DeepSeek（云端） ---
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=deepseek-chat

# --- 示例 2：通义千问 / 阿里云百炼（OpenAI 兼容模式） ---
# LLM_PROVIDER=qwen
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=qwen-plus

# --- 示例 3：OpenAI ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini

# --- 示例 4：LMStudio 本地模型 ---
# LLM_PROVIDER=lmstudio
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen3.6-35b-a3b
# LLM_API_KEY=lm-studio

# --- 示例 5：Ollama 本地模型 ---
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3.6:35b
# LLM_API_KEY=ollama
#
# ⚠️ Ollama 注意事项：
# 1) 后端走 Ollama **原生**端点 /api/chat（由 LLM_BASE_URL 的 /v1 后缀推导）；
#    不走 /v1 兼容层——该层**无法关闭 thinking**（think:false 与 chat_template_kwargs
#    均不生效），思考过程会挤占 max_tokens 并把首字延迟推到 10s+，
#    逼近本项目 15s 首字超时阈值，表现为「LLM 响应超时」。
# 2) 原生端点 think:false 生效：首字延迟 0.11s，思考长度 0。
# 3) 模型名必须与 `ollama list` 输出完全一致（区分 :latest 与具体 tag）。

# ---- 微信小程序登录（可选）----
# 真实 AppID / AppSecret 只放本机 backend/.env，勿提交。
#WECHAT_APP_ID=wxXXXXXXXXXXXXXXXX
#WECHAT_APP_SECRET=
# 逗号分隔邀请码（每个码对应独立账号）；真实码只放本机 .env
#INVITE_CODES=code-for-alice,code-for-bob
